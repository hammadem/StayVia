<%- layout('/layouts/boilerplate') %>
<body>
  <div class="indexpg mt-2 d-flex flex-column ">
  <div class="catBarContainer">
    <button class="scroll-btn left"><i class="fa-regular fa-circle-left" style="color: #000000cc;"></i></button>
    <div class="filters mt-4 mb-1">
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Homestays">
          <i class="fa-solid fa-house"></i>
          <p>Homestays</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Beachfront">
          <i class="fa-solid fa-umbrella-beach"></i>
          <p>Beachfront</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Resorts">
          <i class="fa-solid fa-hotel"></i>
          <p>Resorts</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Mountains">
          <i class="fa-solid fa-mountain-sun"></i>
          <p>Mountains</p>
        </a>
        </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/City Apartments">
          <i class="fa-solid fa-building"></i>
          <p>City Apartments</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Amazing Pools">
          <i class="fa-solid fa-water-ladder"></i>
          <p>Amazing Pools</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Farms">
          <i class="fa-solid fa-cow"></i>
          <p>Farms</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Arctic">
          <i class="fa-regular fa-snowflake"></i>
          <p>Arctic</p>
        </a>
      </div>
      <div class="filter">
        <a class="filterFunc" href="/listings/category/Camping">
          <i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </a>
      </div>
    </div>
    <button class="scroll-btn right"><i class="fa-regular fa-circle-right" style="color: #000000cc;"></i></button>
    <div id="taxPriceToggle">
      <div class="form-check form-switch form-check-reverse mt-2">
        <input class="form-check-input" type="checkbox" id="switchCheckReverse">
        <label class="form-check-label" for="switchCheckReverse">Total with Taxes</label>
      </div>
    </div>
  </div>
    <div class="row row-cols-lg-6 row-cols-1 flex-wrap justify-content-center">
        <% for (let listing of listPresent) {%>
            <div class="card col mt-3" style="width: 15rem;">
                <a class="link-card" href="/listings/<%=listing._id%>">
                <img src="<%=listing.image.url%>" class="card-img-top main-img" alt="<%=listing.title%>">
                <div class="card-img-overlay"></div>
                <div class="card-body index-card-body">
                  <p class="card-text">
                    <span class="title"><b><%=listing.title%></b></span><br>
                    <span class="price">Rs. <%=listing.price.toLocaleString('en-PK')%> / night</span>
                    <span class="tax price"><b><i> + 18% GST</i></b></span>
                  </p>
                </div>
                </a>
            </div>
        <%}%>
    </div><br>
</div>
<script src="/js/index.js"></script>
</body>

