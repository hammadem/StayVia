<%- layout('/layouts/boilerplate') %>
<body>
    <br>
    <h3 class="mb-3 offset-2">New Listing</h3>
<form action="/listings" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
    <div class="row">
        <div class="col-8 offset-2">
            <div class="mb-3">
                <label for="new-title" class="form-label">Title: </label>
                <input type="text" name="listing[title]" class="form-control" id="new-title" placeholder="Catchy Title" required>
                <div class="invalid-feedback">
                    enter a catchy title
                </div>
                <div class="valid-feedback">
                    Title Looks good!
                </div>
            </div>
            <div class="mb-3">
                <label for="new-description" class="form-label">Description: </label>
                <textarea name="listing[description]" id="new-description"  class="form-control" placeholder="Brief Description" required></textarea>
                <div class="invalid-feedback">
                    Please enter brief description
                  </div>
            </div>
            <div class="mb-3">
                <label for="new-img" class="form-label">Image: </label>
                <input type="file"  id="new-img"  name="listing[image]" class="form-control">
            </div>
            <div class="mb-3">
                <label for="new-price" class="form-label">Price: </label>
                <input type="text" id="new-price" name="listing[price]" class="form-control" placeholder="PKR" required>
                <div class="invalid-feedback">
                    Valid Price required
                </div>
            </div>
            <div class="row row-cols-md-2">
                <div class="mb-4 col-md-4">
                    <label for="new-location" class="form-label">Location: </label>
                    <input type="text" id="new-location" class="form-control" name="listing[location]" placeholder="City, State" required>
                    <div class="invalid-feedback">
                        Location required
                    </div>
                </div>
                <div class="mb-4 col-md-8">
                    <label for="new-country" class="form-label">Country: </label>
                    <input type="text" id="new-country" name="listing[country]" class="form-control"  placeholder="Country" required>
                    <div class="invalid-feedback">
                        Country required
                    </div>
                </div>
            </div>
            <div class="mb-4">
                <label for="new-category" class="form-label">Category: </label>
                <select id="new-category" name="listing[category]" class="form-select" required>
                    <option value="" disabled selected>Choose a Category</option>
                    <option value="Homestays">Homestays</option>
                    <option value="Beachfront">Beachfront</option>
                    <option value="Resorts">Resorts</option>
                    <option value="Mountains">Mountains</option>
                    <option value="City Apartments">City Apartments</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Farms">Farms</option>
                    <option value="Arctic">Arctic</option>
                    <option value="Camping">Camping</option>
                </select>
                <div class="invalid-feedback">
                    Category required
                </div>
            </div>
            <input type="submit" class="btn btn-dark" value="Create"><br><br>
        </div>
      </div>
    </form>
</body>